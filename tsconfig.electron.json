{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node", "electron"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["electron", "shared"]
}
